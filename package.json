{
  "name": "hppmusic",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "HppMusic —— 安卓端音乐客户端（Capacitor + Vue 3）。UI 层全新自研，业务内核 vendor 自 EchoMusic。",
  "license": "GPL-3.0-only",
  "scripts": {
    "api:build": "node scripts/build-kugou-api.mjs",
    "dev": "node scripts/build-kugou-api.mjs && vite",
    "build": "node scripts/build-kugou-api.mjs && node scripts/check-boundary.mjs && vue-tsc --noEmit && vite build && node scripts/check-css-compat.mjs && node scripts/check-boot-order.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "boundary": "node scripts/check-boundary.mjs",
    "check": "node scripts/check-boundary.mjs && vue-tsc --noEmit",
    "test": "node scripts/build-kugou-api.mjs && vitest run",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:device": "node scripts/device-eval.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "sync:check": "node scripts/sync-upstream.mjs --check",
    "android:add": "cap add android",
    "android:sync": "node scripts/build-kugou-api.mjs && vite build && node scripts/check-css-compat.mjs && node scripts/check-boot-order.mjs && cap sync android",
    "android:apk": "bash scripts/android-build.sh debug",
    "android:apk:release": "bash scripts/android-build.sh release"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.11",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@iconify/icons-tabler": "^1.2.95",
    "@iconify/types": "^2.0.0",
    "@iconify/vue": "^5.0.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.20.0",
    "big-integer": "^1.6.52",
    "crypto-js": "^4.2.0",
    "esbuild": "^0.28.2",
    "form-data": "^4.0.4",
    "node-forge": "^1.3.1",
    "pako": "^2.1.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.12"
  }
}
