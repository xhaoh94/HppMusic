<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      enableOnBackInvokedCallback：把返回键交给新的 OnBackInvokedDispatcher。
      Android 15+ 对 targetSdk ≥ 35（本项目 36）本来就默认启用预测性返回，
      声明出来是为了让 Android 13/14 也走同一套 —— 否则那里会走老的
      onBackPressed，两套行为的差异很难测（MainActivity 里两套都接了）。
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic：上游的音频与图片大量走 http（非 https），
          关掉这条会让封面和播放地址全部加载失败。
          与 capacitor.config.ts 的 android.allowMixedContent 是两件事：
          后者管的是 https 页面加载 http 子资源，前者管的是明文请求本身。
        -->

        <!--
          蓝牙耳机 / 车机 / 有线线控的媒体按键入口。

          Media3 不会自动注册它，不声明的话按键广播没人接：日志里常年挂着
          `Couldn't find a unique registered media button receiver`，用户按耳机
          上的"下一首"静默无响应。按键最终由 EchoPlaybackService 的
          MediaSession.Callback.onMediaButtonEvent 转成渲染层的切歌事件。
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 后台播放：MediaSessionService，通知栏与锁屏控制由它提供 -->
        <service
            android:name=".EchoPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 应用内分享链路的回调入口（hppmusic://...） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hppmusic" />
            </intent-filter>

            <!-- 从别处「分享文本」进应用（EchoSharePlugin 读取） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台播放的前台服务（Android 14 起必须声明具体的 foregroundServiceType） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ 通知需运行时授权；播放通知没有它就不显示（音乐照常播） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 听歌识曲用麦克风（功能后续接入，权限先声明避免届时要改清单） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      MODIFY_AUDIO_SETTINGS 是 Capacitor 的 BridgeWebChromeClient 在处理
      `getUserMedia`（AUDIO_CAPTURE）时**一并申请**的权限（它把 RECORD_AUDIO 与
      MODIFY_AUDIO_SETTINGS 放在同一次 permissionLauncher.launch 里）。
      不在清单里声明的话这次申请会直接失败，表现为「麦克风权限弹不出来、
      录音静默不工作」—— 而 Web 侧只会看到一个普通的 getUserMedia 拒绝。
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
